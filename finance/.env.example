# Copy to .env and fill in your API keys.
# Finn defaults to Anthropic Claude. Set OPENAI_API_KEY to use OpenAI instead.

# ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: use OpenAI models instead of Claude
# OPENAI_API_KEY=your_openai_key_here

# Optional: override the default model (default: claude-sonnet-4-6)
# FINN_MODEL=claude-opus-4-7

# Optional: manually supply Yahoo Finance session credentials.
# Only needed if your IP is temporarily rate-limited by Yahoo Finance.
# To obtain these: open finance.yahoo.com in a browser, open DevTools → Application →
# Cookies, copy the A1/A1S/A3 values as "Name=Value; Name2=Value2" pairs.
# Then visit finance.yahoo.com/v1/test/getcrumb in the same browser session to get the crumb.
# YF_COOKIE=A1=xxx; A1S=yyy; A3=zzz
# YF_CRUMB=your_crumb_here
